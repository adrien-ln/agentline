# Homebrew formula for agentline (the Claude Code statusline), generated by scripts/construire.sh.
class Agentline < Formula
  desc "Claude Code statusline with 49 themes and an animated theme picker"
  homepage "https://github.com/adrien-ln/agentline"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "@BASE@/agentline_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "@BASE@/agentline_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE@/agentline_@VERSION@_linux_arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "@BASE@/agentline_@VERSION@_linux_amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    bin.install "agentline"
  end

  def caveats
    <<~EOS
      To declare the statusline in ~/.claude/settings.json (a .bak copy is kept):
        agentline install --in-place
      Your terminal needs a Nerd Font, for example:
        brew install --cask font-fira-code-nerd-font
    EOS
  end

  test do
    assert_match "agentline #{version}", shell_output("#{bin}/agentline version")
  end
end
